	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT-license",
	"icon": "assets/redstone-battery/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.nohmobs.redstonebattery.RedstoneBattery"
		],
		"client": [
			"dev.nohmobs.redstonebattery.client.RedstoneBatteryClient"
		],
		"fabric-datagen": [
			"dev.nohmobs.redstonebattery.datagen.RedstoneBatteryDataGenerator"
		]
	},
	"mixins": [
		"redstone-battery.mixins.json"
	],
	"depends": {
